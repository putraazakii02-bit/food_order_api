  "item": [
    {
      "name": "1. Foods (Menu Makanan)",
      "item": [
        {
          "name": "Get All Foods",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/foods",
              "host": ["{{base_url}}"],
              "path": ["foods"]
            }
          }
        },
        {
          "name": "Filter Foods by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/foods?category=Mie",
              "host": ["{{base_url}}"],
              "path": ["foods"],
              "query": [{"key": "category", "value": "Mie"}]
            }
          }
        },
        {
          "name": "Filter Foods Popular Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/foods?is_popular=1",
              "host": ["{{base_url}}"],
              "path": ["foods"],
              "query": [{"key": "is_popular", "value": "1"}]
            }
          }
        },
        {
          "name": "Search Foods",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/foods?search=Geprek",
